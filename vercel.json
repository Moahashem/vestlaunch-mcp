{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "echo 'no build step — Vercel bundles server.ts directly'",
  "rewrites": [
    {
      "source": "/.well-known/oauth-protected-resource",
      "destination": "/api/oauth-protected-resource"
    },
    {
      "source": "/.well-known/oauth-protected-resource/api/mcp",
      "destination": "/api/oauth-protected-resource"
    },
    {
      "source": "/.well-known/oauth-authorization-server",
      "destination": "/api/oauth-authorization-server"
    },
    {
      "source": "/authorize",
      "destination": "/api/authorize"
    },
    {
      "source": "/token",
      "destination": "/api/token"
    },
    {
      "source": "/register",
      "destination": "/api/oauth-register"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/daily-lead-count",
      "schedule": "0 11 * * *"
    },
    {
      "path": "/api/cron/daily-lead-count",
      "schedule": "20 11 * * *"
    },
    {
      "path": "/api/cron/daily-lead-count",
      "schedule": "40 11 * * *"
    },
