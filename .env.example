# ============================================================
# VestLaunch MCP — Environment Variables
# ============================================================
# Copy this to .env and fill in your per-agent values.
# Each agent should have its own API key with the minimum scopes
# it needs. See README.md for the full per-agent setup recipe.
# ============================================================

# Required — base URL of the FFL CRM API (no trailing slash).
# Production:  https://crm.vestlaunch.com
# Local dev:   http://localhost:3000
VESTLAUNCH_BASE_URL="https://crm.vestlaunch.com"

# Required — your agent's API key, generated at:
#   <VESTLAUNCH_BASE_URL>/settings  → API Keys section
# Best practice: name the key after the agent (e.g. "claude-cowork",
# "claude-code-mac", "clawbot-vps") so the CRM ApiLog table shows
# exactly which agent did what.
VESTLAUNCH_API_KEY="ffl_live_..."

# Optional — enable write tools (POST/PATCH/DELETE).
# Default is read-only. Set to "true" only on keys that have the
# corresponding *:write scopes.
VESTLAUNCH_ENABLE_WRITES="false"

# Optional — log level for the MCP server's own stderr output.
# One of: "silent" | "error" | "warn" | "info" | "debug"
VESTLAUNCH_LOG_LEVEL="info"

# Optional — per-request timeout in milliseconds. Default 30000.
VESTLAUNCH_TIMEOUT_MS="30000"

# ============================================================
# HOSTED (Vercel) MODE — for the HTTP/Streamable MCP + daily cron
# ============================================================
# These are ONLY needed when deploying to Vercel (api/mcp.ts +
# api/cron/daily-lead-count.ts). Set them in the Vercel project's
# Environment Variables — never commit real values.

# --- api/mcp.ts (the hosted MCP endpoint) ---
# Bearer token that protects the MCP endpoint. The Claude Managed
# Agents credential vault stores this same token (auth.type:
# static_bearer) bound to https://<your-app>.vercel.app/api/mcp and
# injects it on every connect. Generate a long random string.
MCP_BEARER_TOKEN="generate-a-long-random-string"
# (VESTLAUNCH_BASE_URL + VESTLAUNCH_API_KEY above are also required in
#  Vercel env. Use a READ-ONLY VestLaunch key here and leave
#  VESTLAUNCH_ENABLE_WRITES unset/false.)

# --- api/cron/daily-lead-count.ts (the morning trigger) ---
# Anthropic API key with Managed Agents access (the cron uses it to
# create a session + send the kickoff event).
ANTHROPIC_API_KEY="sk-ant-..."
# The Managed Agents objects the cron targets:
FFL_AGENT_ID="agent_01UQzJ4ZKLP7JGYsBvwptu74"
FFL_ENVIRONMENT_ID="env_01JaER...hnr6GA"
FFL_VAULT_ID="vlt_011CbdGFbUSSxVsDm7Mymq77"
# Gate for the cron endpoint. Set this in Vercel and Vercel will send
# "Authorization: Bearer <CRON_SECRET>" on cron invocations.
CRON_SECRET="generate-a-long-random-string"
# Optional — override the daily kickoff message sent to the agent.
# FFL_DAILY_PROMPT="Run your daily landlord-lead count now..."
