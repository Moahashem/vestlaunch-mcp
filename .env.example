# ============================================================
# VestLaunch MCP — Environment Variables
# ============================================================
# Copy this to .env and fill in your per-agent values.
# Each agent should have its own API key with the minimum scopes
# it needs. See README.md for the full per-agent setup recipe.
# ============================================================

# Required — base URL of the FFL CRM API (no trailing slash).
# Production:  https://crm.vestlaunch.com
# Local dev:   http://localhost:3000
VESTLAUNCH_BASE_URL="https://crm.vestlaunch.com"

# Required — your agent's API key, generated at:
#   <VESTLAUNCH_BASE_URL>/settings  → API Keys section
# Best practice: name the key after the agent (e.g. "claude-cowork",
# "claude-code-mac", "clawbot-vps") so the CRM ApiLog table shows
# exactly which agent did what.
VESTLAUNCH_API_KEY="ffl_live_..."

# Optional — enable write tools (POST/PATCH/DELETE).
# Default is read-only. Set to "true" only on keys that have the
# corresponding *:write scopes.
VESTLAUNCH_ENABLE_WRITES="false"

# Optional — log level for the MCP server's own stderr output.
# One of: "silent" | "error" | "warn" | "info" | "debug"
VESTLAUNCH_LOG_LEVEL="info"

# Optional — per-request timeout in milliseconds. Default 30000.
VESTLAUNCH_TIMEOUT_MS="30000"

# ============================================================
# HOSTED (Vercel) MODE — for the HTTP/Streamable MCP + daily crons
# ============================================================
# These are ONLY needed when deploying to Vercel (api/mcp.ts +
# api/cron/*.ts). Set them in the Vercel project's Environment
# Variables — never commit real values.

# --- api/mcp.ts (the hosted MCP endpoint) ---
# Bearer token that protects the MCP endpoint. The Claude Managed
# Agents credential vault stores this same token (auth.type:
# static_bearer) bound to https://<your-app>.vercel.app/api/mcp and
# injects it on every connect. Generate a long random string.
MCP_BEARER_TOKEN="generate-a-long-random-string"
# (VESTLAUNCH_BASE_URL + VESTLAUNCH_API_KEY above are also required in
#  Vercel env. Use a READ-ONLY VestLaunch key here and leave
#  VESTLAUNCH_ENABLE_WRITES unset/false.)

# --- Shared by ALL cron triggers (api/cron/*.ts) ---
# Anthropic API key with Managed Agents access (each cron uses it to
# create a session + send the kickoff event).
ANTHROPIC_API_KEY="sk-ant-..."
# Shared Managed Agents objects every FFL agent runs on:
FFL_ENVIRONMENT_ID="env_01JaER...hnr6GA"   # environment "ffl-agents"
FFL_VAULT_ID="vlt_011CbdGFbUSSxVsDm7Mymq77" # vault "ffl-mcp"
# Gate for the cron endpoints. Set this in Vercel and Vercel will send
# "Authorization: Bearer <CRON_SECRET>" on cron invocations.
CRON_SECRET="generate-a-long-random-string"

# AI Workforce hub — run-status reporter (api/workforce-hub.ts). After each cron
# kicks off its agent it POSTs a run-status row to
# <VESTLAUNCH_BASE_URL>/api/v1/agent/run-status so Ruckus + the Mission Control
# page can see the morning pipeline fire/fail. Use a DEDICATED ffl-crm API key
# (generate at <VESTLAUNCH_BASE_URL>/settings) scoped agent:write. Best-effort:
# if unset, the crons simply skip reporting — the agent kickoff is unaffected.
# (VESTLAUNCH_BASE_URL above is reused as the hub base URL.)
FFL_WORKFORCE_API_KEY="ffl_live_..."

# --- api/cron/daily-lead-count.ts (Sales agent, 6:00 AM CT) ---
FFL_AGENT_ID="agent_01UQzJ4ZKLP7JGYsBvwptu74"
# Optional — override the daily kickoff message sent to the agent.
# FFL_DAILY_PROMPT="Run your daily landlord-lead count now..."

# --- api/cron/daily-occupancy.ts (AppFolio agent #2, 6:10 AM CT + retries) ---
FFL_OCCUPANCY_AGENT_ID="agent_015XERb8X96E2JiXpKrWrdEn"
# Optional — override the occupancy kickoff message.
# FFL_OCCUPANCY_PROMPT="Run your daily FFL occupancy/renewals/delinquency/leasing update now..."

# --- api/cron/daily-showmojo.ts (ShowMojo agent, 6:20 AM CT + retries) ---
# Set this AFTER creating the ShowMojo agent (paste its agent_... id here).
FFL_SHOWMOJO_AGENT_ID="agent_..."
# Optional — override the ShowMojo kickoff message.
# FFL_SHOWMOJO_PROMPT="Run your daily FFL Homes update now..."

# --- api/cron/daily-boom-screenings.ts (BoomScreen applications pull, after occupancy) ---
# Deterministic pull (no agent): authenticates to the Boom Partner API and counts
# SUBMITTED screening applications by Central-Time month, then writes ffl.applications
# to the hub with source "Boom". This is the accurate, stage-proof applications count
# (it survives approved/declined moving out of the LeadSimple screening stage).
# Get these from the Boom Partner Portal → Settings → API (the "VestLaunch Company
# Numbers" key). BOTH the access key and its secret key are required.
BOOM_ACCESS_KEY=""
BOOM_SECRET_KEY=""
# Optional — override the Boom API base. Default https://api.boompay.app
# (sandbox: https://api.sandbox.boompay.app)
# BOOM_API_BASE="https://api.boompay.app"
# (Reuses FFL_WORKFORCE_API_KEY / VESTLAUNCH_API_KEY to write the hub snapshot,
#  VESTLAUNCH_BASE_URL as the hub base, and CRON_SECRET to gate the endpoint.)
